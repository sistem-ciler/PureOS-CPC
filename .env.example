# Copy to .env and fill in values before running

APP_NAME="OTC Secure Comm"
DEBUG=false

# SQLite for development; swap to postgresql+asyncpg://... for production
DATABASE_URL=sqlite+aiosqlite:///./otc_saas.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret

# First-run admin account (used by startup to seed the DB)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# OTC lifetime defaults (seconds)
OTC_DEFAULT_TTL=1800
OTC_MAX_TTL=86400

# Rate limit per minute per IP
RATE_LIMIT_PER_MINUTE=60
